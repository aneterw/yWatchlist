{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yWatchlist",
  "version": "1.0.1",
  "identifier": "com.aneter-minipc.ywatchlist",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "yWatchlist v1.0.0 - 自選股管理器",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": ["python/*", "python-embed-full/*", "python-embed-full/Lib/**/*"],
    "shortDescription": "自選股管理器",
    "longDescription": "yWatchlist 是一款功能強大的自選股管理工具，支持多種語言、延遲報價（Yahoo Finance 報價約延遲 15-20 分鐘）、技術分析和價格提醒功能。",
    "licenseFile": "LICENSE.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}