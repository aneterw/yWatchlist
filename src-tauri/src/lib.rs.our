use serde::{Deserialize, Serialize};
use std::path::Path;
use std::process::Command;

#[cfg(windows)]
use std::os::windows::process::CommandExt;

const CREATE_NO_WINDOW: u32 = 0x08000000;

#[cfg(windows)]
fn hidden_command(program: &std::path::Path) -> Command {
    let mut cmd = Command::new(program);
    cmd.creation_flags(CREATE_NO_WINDOW);
    cmd
}

#[cfg(not(windows))]
fn hidden_command(program: &std::path::Path) -> Command {
    Command::new(program)
}

#[cfg(windows)]
fn hidden_command_str(program: &str) -> Command {
    let mut cmd = Command::new(program);
    cmd.creation_flags(CREATE_NO_WINDOW);
    cmd
}

#[cfg(not(windows))]
fn hidden_command_str(program: &str) -> Command {
    Command::new(program)
}

#[derive(Serialize, Deserialize, Debug)]
pub struct PriceData {
    pub ticker: String,
    #[serde(rename = "name")]
    pub name: String,
    #[serde(rename = "price")]
    pub price: Option<f64>,
    #[serde(rename = "change")]
    pub change: Option<f64>,
    #[serde(rename = "pct_change")]
    pub pct_change: Option<f64>,
    #[serde(rename = "volume")]
    pub volume: Option<i64>,
    #[serde(rename = "market_cap")]
    pub market_cap: Option<i64>,
}

#[derive(Serialize, Deserialize, Debug)]
pub struct WatchlistData {
    #[serde(rename = "active_wl")]
    pub active_wl: Option<String>,
    #[serde(rename = "watchlists")]
    pub watchlists: serde_json::Value,
    #[serde(rename = "lang")]
    pub lang: Option<String>,
    #[serde(rename = "theme")]
    pub theme: Option<String>,
    #[serde(rename = "alerts")]
    pub alerts: serde_json::Value,
}

#[derive(Serialize, Deserialize, Debug)]
pub struct SearchResult {
    pub display: String,
    pub symbol: String,
    pub name: String,
}

#[derive(Serialize, Deserialize, Debug)]
pub struct ChartData {
    pub date: String,
    pub open: f64,
    pub high: f64,
    pub low: f64,
    pub close: f64,
    pub volume: i64,
}

